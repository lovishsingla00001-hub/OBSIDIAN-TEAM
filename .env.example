# ==============================================================================
# SiteCheck — Supabase & Environment Configuration
# ==============================================================================

# Your Supabase Project URL (find in Project Settings -> API)
# Example: https://abcdefghijklm.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anon Key (find in Project Settings -> API -> anon public)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# (Optional) Supabase Service Role Key for elevated backend privileges (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=

# Local Server Port (default: 3001)
PORT=3001

# Local Ollama AI Model (optional, default: gemma4:e4b)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
